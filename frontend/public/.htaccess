<IfModule mod_headers.c>
  # Cabeceras de Seguridad Defensiva
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
</IfModule>

# Bloquear acceso a archivos sensibles y scripts de diagnóstico
<FilesMatch "(composer\.(json|lock)|config\.(php|local\.php)|check_db\.php|phpver\.php|\.env)$">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Proteger archivos y directorios ocultos (excepto .well-known para certificados SSL)
  RewriteRule (^|/)\.(?!well-known) - [F]

  # Redirigir llamadas API a backend/public/index.php
  RewriteRule ^api/(.*)$ backend/public/index.php [QSA,L]

  # Soporte para carpetas uploads anidadas accidentalmente
  RewriteRule ^uploads/uploads/(.*)$ uploads/$1 [L]
  RewriteRule ^backend/public/uploads/uploads/(.*)$ backend/public/uploads/$1 [L]
  RewriteRule ^backend/uploads/uploads/(.*)$ backend/uploads/$1 [L]

  # ── Resolucion de imagenes solicitadas como /backend/public/uploads/... ──
  # 1. Si existe en backend/public/uploads/... (servir directamente)
  RewriteCond %{DOCUMENT_ROOT}/backend/public/uploads/$1 -f
  RewriteRule ^backend/public/uploads/(.*)$ backend/public/uploads/$1 [L]

  # 2. Si existe en uploads/...
  RewriteCond %{DOCUMENT_ROOT}/uploads/$1 -f
  RewriteRule ^backend/public/uploads/(.*)$ uploads/$1 [L]

  # ── Resolucion de imagenes solicitadas como /uploads/... ──
  # 1. Si existe en backend/public/uploads/...
  RewriteCond %{DOCUMENT_ROOT}/backend/public/uploads/$1 -f
  RewriteRule ^uploads/(.*)$ backend/public/uploads/$1 [L]

  # 2. Si existe en uploads/...
  RewriteCond %{DOCUMENT_ROOT}/uploads/$1 -f
  RewriteRule ^uploads/(.*)$ uploads/$1 [L]

  # Si el archivo o directorio fisico existe, servirlo directamente sin reescribir
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Servir archivos estaticos criticos directamente
  RewriteRule ^(robots\.txt|sitemap\.xml|favicon\.ico|favicon\.png|manifest\.webmanifest)$ - [L]

  # No reescribir uploads, backend ni llamadas de API a index.html
  RewriteCond %{REQUEST_URI} ^/(uploads|backend|api)/
  RewriteRule ^ - [L]

  # SPA Routing (React Router)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
