{
    "name": "sistema3ld/api",
    "description": "Backend PHP para Sistema 3LD ERP",
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.13",
        "slim/psr7": "^1.7",
        "firebase/php-jwt": "^6.11",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "audit": {
            "abandoned": "ignore"
        },
        "secure-http": true
    },
    "extra": {
        "advisory-ignore": ["PKSA-y2cr-5h3j-g3ys"]
    }
}
